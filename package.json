{
  "name": "xelulu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm build && tsc -p tsconfig.test.json && vitest run && pnpm --filter @xelulu/parent-app test",
    "start:app": "pnpm --filter @xelulu/parent-app start",
    "dev:admin": "pnpm --filter @xelulu/admin dev",
    "dev:admin:content": "pnpm --filter @xelulu/admin exec vite --mode content-admin",
    "dev:admin:device": "pnpm --filter @xelulu/admin exec vite --mode device-control",
    "start:gateway": "pnpm --silent --filter @xelulu/gateway start",
    "start:simulator": "pnpm --silent --filter @xelulu/simulator start"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "smol-toml": "1.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
